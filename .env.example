# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — gracefully disabled when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM providers (OpenAI-compatible). Configure one or more; they are tried in order.
# Provider 1 (primary)
LLM_PROVIDER_1_NAME=openai
LLM_PROVIDER_1_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_1_API_KEY=
LLM_PROVIDER_1_MODEL=gpt-4o-mini
# Provider 2 (fallback, optional — copy block and increment the index)
# LLM_PROVIDER_2_NAME=deepseek
# LLM_PROVIDER_2_BASE_URL=https://api.deepseek.com/v1
# LLM_PROVIDER_2_API_KEY=
# LLM_PROVIDER_2_MODEL=deepseek-chat

# Embeddings for RAG (OpenAI-compatible /embeddings endpoint)
LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API key encryption for DB-stored LLM providers (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Required for adding/updating providers in 设置 / LLM 供应商.
APP_ENCRYPTION_KEY=

# Console login (single admin account). The whole console (pages + internal APIs)
# requires login; without ADMIN_PASSWORD the login endpoint returns 503.
# ADMIN_USERNAME defaults to "admin01" when unset.
ADMIN_USERNAME=admin01
ADMIN_PASSWORD=
# Session JWT signing key (any random string, e.g. openssl rand -hex 32).
# Falls back to APP_ENCRYPTION_KEY when unset.
AUTH_SECRET=
